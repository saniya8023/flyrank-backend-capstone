# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (asyncpg driver) ---
DATABASE_URL=postgresql+asyncpg://billing_user:billing_pass@localhost:5432/billing_engine
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Stripe Test Mode ---
# Get these from https://dashboard.stripe.com/test/apikeys and
# `stripe listen --forward-to localhost:8000/v1/webhooks/stripe`
STRIPE_API_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxxxxxx

# --- Quota / Metering ---
QUOTA_CLOCK_SKEW_SECONDS=5
DEFAULT_RETRY_AFTER_SECONDS=3600

# --- AI Token Pricing (integer micro-cents per token; 10000 micro-cents = 1 cent) ---
RATE_INPUT_MICRO_CENTS_PER_TOKEN=30
RATE_CACHED_INPUT_MICRO_CENTS_PER_TOKEN=8
RATE_OUTPUT_MICRO_CENTS_PER_TOKEN=150
RATE_REASONING_MICRO_CENTS_PER_TOKEN=150

# --- Plan defaults (seed values) ---
FREE_PLAN_API_CALL_LIMIT=1000
FREE_PLAN_TOKEN_LIMIT=100000
PRO_PLAN_API_CALL_LIMIT=100000
PRO_PLAN_TOKEN_LIMIT=10000000
PRO_PLAN_PRICE_CENTS=4900